{
  "name": "nalssilog-web",
  "version": "0.1.13",
  "private": true,
  "scripts": {
    "config:init": "git -c submodule.env-config.update=checkout submodule update --init --checkout env-config && git -C env-config switch main && git -C env-config pull --ff-only origin main && npm run config:sync",
    "config:sync": "node scripts/sync-private-config.mjs",
    "predev": "npm run config:sync",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@sentry/nextjs": "^10.67.0",
    "@tanstack/react-query": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "pretendard": "^1.3.9",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
